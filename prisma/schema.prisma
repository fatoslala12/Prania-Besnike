generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PERFAQESUES
  RECEPSION
  ADMIN
  MONITORUES
  ADMINISTRATOR
}

enum TaskStatus {
  I_RI
  NE_PROCES
  PERFUNDUAR
  BLOKUAR
}

enum EventType {
  CREATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  DOCUMENT_UPLOADED
  UPDATED
  RESPONSE_ADDED
  EMAIL_SENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(PERFAQESUES)
  orgUnit      String?
  active       Boolean  @default(true)
  /// Njoftimet në panel vijnë gjithmonë; ky flamur ndal vetëm kopjen me email.
  emailNotifications Boolean @default(true)
  /// Pas një fjalëkalimi të përkohshëm nga administratori, paneli kërkon ndryshimin e tij.
  mustChangePassword Boolean @default(false)
  /// Rritet kur fjalëkalimi rivendoset nga jashtë; seancat me version të vjetër mbyllen.
  sessionVersion     Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdTasks   Task[]               @relation("TaskCreator")
  assignedTasks  Task[]               @relation("TaskAssignee")
  comments       TaskComment[]
  documents      Document[]
  events         TaskEvent[]
  notifications  Notification[]
  responses      TaskResponse[]
  passwordResets PasswordResetToken[]
  extraRoles     UserRole[]

  @@index([orgUnit])
}

/// Role shtesë: përdoruesi zgjedh në hyrje me cilin rol punon (User.role mbetet roli kryesor).
model UserRole {
  id        String   @id @default(cuid())
  role      Role
  orgUnit   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgUnit])
}

/// Task.orgUnit / User.orgUnit ruajnë emrin; riemërtimi i përditëson të dyja.
model OrgUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Ruhet vetëm hash-i SHA-256 i token-it; token-i i plotë ekziston vetëm te lidhja në email.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id               String     @id @default(cuid())
  number           String     @unique
  title            String
  description      String     @db.Text
  status           TaskStatus @default(I_RI)
  orgUnit          String?
  citizenName      String?
  citizenEmail     String?
  citizenPhone     String?
  requestDate      DateTime?
  isCitizenRequest Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  creatorId  String?
  creator    User?   @relation("TaskCreator", fields: [creatorId], references: [id])
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  comments      TaskComment[]
  documents     Document[]
  events        TaskEvent[]
  notifications Notification[]
  responses     TaskResponse[]

  @@index([orgUnit])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  kind      String
  title     String
  body      String    @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([kind, createdAt])
}

/// Përgjigje zyrtare e drejtorisë (numri: <task.number>-<seq>); ndryshohet vetëm derisa të dërgohet me email.
model TaskResponse {
  id         String    @id @default(cuid())
  seq        Int
  content    String    @db.Text
  orgUnit    String
  isFinal    Boolean   @default(false)
  authorName String
  sentAt     DateTime?
  sentTo     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([taskId, seq])
}

model TaskCounter {
  year  Int @id
  value Int
}

model TaskEvent {
  id        String    @id @default(cuid())
  type      EventType
  message   String    @db.Text
  actorName String
  meta      Json?
  createdAt DateTime  @default(now())

  taskId  String
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([createdAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

model Document {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime @default(now())
  /// Dërgimi i fundit te kërkuesi me email (mund të ridërgohet).
  sentAt       DateTime?
  sentTo       String?

  taskId       String
  task         Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
}

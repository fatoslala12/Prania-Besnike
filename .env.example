# local = .data/store.json (test pa DB)
# postgres = PostgreSQL (Dokploy / Hetzner)
DATA_MODE="local"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/prania_besnike?schema=public"

# NextAuth — openssl rand -base64 32
AUTH_SECRET="ndryshoje-me-secret-te-forte"
AUTH_URL="https://domaini-juaj.al"

# Admini fillestar (krijohet vetëm nëse nuk ka asnjë admin)
ADMIN_PASSWORD=""
ADMIN_EMAIL="admin@praniabesnike.al"
ADMIN_USERNAME="admin"

# true = shton recepsion/perfaqesues me fjalëkalim demo (vetëm test)
SEED_DEMO="false"

# Dosja e dokumenteve (në Docker: /app/uploads, volum i përhershëm)
UPLOAD_DIR=""

# Njoftime me email (SMTP_HOST bosh = vetëm njoftime brenda aplikacionit)
# Gmail: SMTP_PASS është "App Password" 16-shifror (Google Account → Security → 2-Step Verification → App passwords),
# jo fjalëkalimi normal i llogarisë.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER="pranibesnike@gmail.com"
SMTP_PASS=""
MAIL_FROM="Prania Besnike MSHMS <pranibesnike@gmail.com>"

# Vetëm për docker-compose
POSTGRES_PASSWORD=""
